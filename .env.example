# Server-only settings. Never prefix secrets with VITE_.
PORT=3100
# Local Vite origin. On Vercel set this to your custom site's https:// domain.
# Vercel production, deployment and branch URLs are also allowed automatically.
APP_ORIGIN=http://localhost:5173
ADMIN_USERNAME=admin
# Run npm run setup:admin to generate a salted password hash in .env.local.
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
PMS_API_BASE_URL=https://pms-api.hio.ai.kr/api
PMS_API_KEY=
